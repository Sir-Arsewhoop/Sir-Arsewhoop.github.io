source "https://rubygems.org"

# Pins Jekyll and every plugin to exactly the versions GitHub Pages runs, so a
# local build cannot diverge from production. Do not add gems outside this
# bundle: anything off GitHub's allowlist builds locally and silently does
# nothing on Pages.
gem "github-pages", group: :jekyll_plugins

# Windows and JRuby ship no zoneinfo database of their own.
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
